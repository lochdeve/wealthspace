# =============================================================================
# Wealthspace — variables de entorno (copiar a .env en la raíz o por app)
# =============================================================================
# No commitear archivos .env con secretos reales.

# --- PostgreSQL (docker-compose / desarrollo local) ---
POSTGRES_USER=wealthspace
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=wealthspace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión para Prisma (backend) — usar cuando se configure Prisma
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- API (apps/api) ---
API_PORT=3001
# NODE_ENV=development

# --- Web (apps/web) ---
# URL pública de la API consumida por el frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
