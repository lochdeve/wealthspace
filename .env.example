# =============================================================================
# Wealthspace — variables de entorno (copiar a .env en la raíz o por app)
# =============================================================================
# No commitear archivos .env con secretos reales.

# --- PostgreSQL (docker-compose / desarrollo local) ---
POSTGRES_USER=wealthspace
POSTGRES_PASSWORD=wealthspace_dev
POSTGRES_DB=wealthspace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión para Prisma (backend) — obligatoria para arrancar la API
# Sustituye credenciales reales; Node no expande ${...} automáticamente.
DATABASE_URL=postgresql://wealthspace:wealthspace_dev@localhost:5432/wealthspace?schema=public

# --- API (apps/api) ---
API_PORT=3001
# Origen del frontend para CORS con credenciales (cookie de sesión)
WEB_ORIGIN=http://localhost:3000
# NODE_ENV=production en despliegue real (cookie Secure); development en local
# NODE_ENV=development
# Firmar JWT de sesión (mín. 32 caracteres; obligatorio para arrancar la API)
JWT_SECRET=change-me-use-at-least-32-random-characters
# JWT_EXPIRES_IN=7d

# --- Web (apps/web) ---
# Base URL para llamadas API (sin /api/v1). Local: API directa en :3001.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Producción Vercel+Railway: proxy same-origin — ver docs/development/release-runbook.md §8.9
# API_PROXY_TARGET=https://tu-api.up.railway.app
# NEXT_PUBLIC_API_URL=https://tu-proyecto.vercel.app
