{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolvePackageJsonExports": false,
    "declaration": false,
    "noEmit": true,
    "incremental": false,
    "types": ["jest", "node"]
  },
  "include": ["test/**/*.ts", "src/**/*.spec.ts"]
}
